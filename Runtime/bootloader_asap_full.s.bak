; ============================================================
; MSP430FR5969 ASAP Bootloader (完整版，带恢复逻辑)
; 功能：
;   1. 硬件初始化
;   2. 检查是否需要恢复（扫描commit bits）
;   3. 如果需要恢复 → 调用 _asap_restore
;   4. 否则 → 跳转到 main（冷启动）
; ============================================================

	.section .init9, "ax", @progbits
	.global _bootloader_entry
	.type _bootloader_entry, @function

; 外部符号声明
	.extern main
	.extern _asap_restore
	.extern _total_wids

_bootloader_entry:
	; ===== 步骤1: 硬件初始化 =====
	; 1.1 初始化栈指针
	MOV	#0x2400, R1		; SP = 0x2400 (RAM末尾)
	
	; 1.2 关闭看门狗（防止复位）
	MOV	#0x5A80, &0x015C	; WDTCTL = WDTPW | WDTHOLD
	
	; 1.3 解锁GPIO (LOCKLPM5=0)
	MOV.W	&0x0130, R12
	BIC.W	#1, R12
	MOV.W	R12, &0x0130		; PM5CTL0 &= ~LOCKLPM5
	
	; 1.4 配置时钟：DCO = 8MHz, SMCLK = DCO
	MOV.B	#0xA5, &0x0161		; CSCTL0_H = 0xA5 (解锁)
	MOV.W	#0x0046, &0x0162	; CSCTL1 = DCOFSEL_3 | DCORSEL (8MHz)
	MOV.W	#0x0033, &0x0164	; CSCTL2 = SELS__DCOCLK | SELM__DCOCLK
	MOV.W	#0x0000, &0x0166	; CSCTL3 = DIVS__1 | DIVM__1
	MOV.B	#0, &0x0161		; CSCTL0_H = 0 (锁回)
	
	; ===== 步骤2: 检查是否需要恢复 =====
	; 扫描所有commit bits，看是否有未完成的写
	; Commit bits区域：0x8000-0x80FF (假设最多256个WID)
	
	MOV	#0x8000, R12		; R12 = commit_bits起始地址
	MOV	#0, R13			; R13 = 扫描计数
	MOV	#0, R14			; R14 = 是否需要恢复（0=不需要，1=需要）
	
	; 获取WID总数
	MOV	&_total_wids, R15	; R15 = WID总数
	CMP	#0, R15
	JEQ	_boot_cold_start	; 如果没有WID，直接冷启动
	
_boot_check_loop:
	; 检查当前commit bit
	CMP.B	#1, 0(R12)		; commit_bits[i] == 1?
	JEQ	_boot_need_recovery	; 如果==1，说明有未完成的写，需要恢复
	
	; 继续下一个
	INC	R12			; commit_bits++
	INC	R13			; count++
	CMP	R13, R15		; count < total_wids?
	JLO	_boot_check_loop	; 继续循环
	
	; 所有commit bits都是0 → 冷启动
	JMP	_boot_cold_start
	
_boot_need_recovery:
	; ===== 步骤3: 恢复路径 =====
	; 红灯短闪（表示进入恢复）
	BIS.B	#1, &0x0204		; P1DIR |= BIT0
	BIC.B	#1, &0x0202		; P1OUT &= ~BIT0 (红灯亮)
	
	; 短延时
	MOV	#0x1FFF, R14
_boot_recovery_delay:
	DEC	R14
	JNZ	_boot_recovery_delay
	
	BIS.B	#1, &0x0202		; P1OUT |= BIT0 (红灯灭)
	
	; 调用恢复逻辑
	CALL	#_asap_restore		; _asap_restore 会跳转到NextPC，不会返回
	
	; 不应该到这里
	JMP	_boot_halt
	
_boot_cold_start:
	; ===== 步骤4: 冷启动路径 =====
	; 绿灯短闪（表示冷启动）
	BIS.B	#0x40, &0x0224		; P4DIR |= BIT6
	BIC.B	#0x40, &0x0222		; P4OUT &= ~BIT6 (绿灯亮)
	
	; 延时
	MOV	#10, R15
_boot_cold_outer:
	MOV	#0xFFFF, R14
_boot_cold_delay:
	DEC	R14
	JNZ	_boot_cold_delay
	DEC	R15
	JNZ	_boot_cold_outer
	
	BIS.B	#0x40, &0x0222		; P4OUT |= BIT6 (绿灯灭)
	
	; 清空所有commit bits（冷启动前清理状态）
	MOV	#0x8000, R12
	MOV	&_total_wids, R15
	CMP	#0, R15
	JEQ	_boot_jump_main
	
_boot_clear_commits:
	MOV.B	#0, 0(R12)		; commit_bits[i] = 0
	INC	R12
	DEC	R15
	JNZ	_boot_clear_commits
	
_boot_jump_main:
	; 跳转到main（不会返回）
	BR	#main
	
_boot_halt:
	; 异常停止
	JMP	_boot_halt
	
	.size _bootloader_entry, .-_bootloader_entry

; ============================================================
; 复位向量：指向bootloader入口（段名必须是.resetvec）
; ============================================================
	.section .resetvec, "a"
	.word _bootloader_entry

