#!/usr/bin/env python3
"""
Stage 7: 提取WID→PC映射
从临时固件的反汇编中提取每个WID标签对应的实际PC地址
输入: build/firmware_temp.elf (已编译的固件)
输出: build/wid_pc_map.json
"""
import argparse
import json
import subprocess
import re

def extract_wid_pc_map(firmware_elf, objdump='msp430-elf-objdump'):
    """从固件反汇编中提取WID→PC映射（基于__WID_标签后的代码）"""
    
    # 反汇编固件
    cmd = [objdump, '-d', '-j', '.text', firmware_elf]
    result = subprocess.run(cmd, capture_output=True, text=True, check=True)
    disasm = result.stdout
    
    wid_pc_map = {}
    lines = disasm.split('\n')
    
    for i, line in enumerate(lines):
        # 匹配WID标签: "00004408 <__WID_W001>:"
        wid_match = re.match(r'([0-9a-f]+)\s+<__WID_(W\d+)>:', line)
        if wid_match:
            wid = wid_match.group(2)
            
            # 找到WID标签后的实际代码行（跳过注释、MOV指令等备份代码）
            # WID后的指令序列：
            # - 注释行
            # - MOV.W xxx, &SLOT (备份数据)
            # - MOV.W R1, &ASAP_SP_SAVE
            # - MOV.W #N, &ASAP_WID_SAVE
            # - [下一条指令] ← 这是恢复点
            
            # WID备份序列：
            # 1. MOV data, &FRAM_SLOT (0x6400-0x6FFF)
            # 2. MOV R1, &ASAP_SP_SAVE (0x7004)
            # 3. MOV #WID, &ASAP_WID_SAVE (0x7000)
            # 需要跳过这些，找第一条非备份指令作为nextPC
            
            for j in range(i+1, min(i+20, len(lines))):
                next_line = lines[j]
                # 匹配完整指令行（必须有操作码，如mov/add/call等）
                # 格式: "    8a0c:	3c 40 54 86 	mov	#-31148,r12"
                instr_match = re.match(r'^\s+([0-9a-f]+):\s+[0-9a-f ]+\s+(mov|add|sub|call|cmp|jmp|br|push|pop|ret|inc|dec|clr|bis|bic|and|or|xor|rla|rra|swpb|sxt)', next_line, re.IGNORECASE)
                if instr_match:
                    # 检查是否是备份指令（写入FRAM或ASAP变量区）
                    # FRAM: 0x6400-0x6FFF, ASAP: 0x7000-0x7004
                    is_backup = (re.search(r'&0x6[4-9a-f][0-9a-f]{2}', next_line) or
                                re.search(r'&0x700[0-4]', next_line))
                    if not is_backup:
                        # 这是备份后的第一条正常指令
                        pc = f"0x{instr_match.group(1).upper()}"
                        wid_pc_map[wid] = pc
                        break
    
    return wid_pc_map

def main():
    parser = argparse.ArgumentParser(description='Stage 7: 提取WID→PC映射')
    parser.add_argument('firmware', help='临时固件ELF文件')
    parser.add_argument('--output', default='build/wid_pc_map.json', help='输出JSON')
    parser.add_argument('--objdump', default='msp430-elf-objdump', help='objdump工具')
    
    args = parser.parse_args()
    
    # 提取映射
    wid_pc_map = extract_wid_pc_map(args.firmware, args.objdump)
    
    # 输出JSON
    with open(args.output, 'w') as f:
        json.dump(wid_pc_map, f, indent=2)
    
    print(f"  ✓ 提取WID→PC映射:")
    print(f"    - 找到 {len(wid_pc_map)} 个WID")
    
    # 显示前10个
    for wid, pc in list(sorted(wid_pc_map.items()))[:10]:
        print(f"    {wid}: {pc}")
    if len(wid_pc_map) > 10:
        print(f"    ... 还有 {len(wid_pc_map) - 10} 个")
    
    print(f"  ✓ 输出: {args.output}")

if __name__ == '__main__':
    main()
